{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "&/*": ["./server/*"],
      "shared/*": ["./shared/*"]
    }
  },
  "include": ["server"]
}